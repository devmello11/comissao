# Copie para .env.local e preencha (nunca comite o arquivo preenchido).

# Conexão com o Postgres. Na Vercel isso é injetado automaticamente
# quando você conecta o banco Neon ao projeto — só precisa aqui pra rodar local.
DATABASE_URL=postgres://usuario:senha@host.neon.tech/neondb?sslmode=require

# Senha de acesso ao caderno. Defina a sua.
APP_SENHA=troque-esta-senha
