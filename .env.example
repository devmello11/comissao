# Copie para .env.local e preencha (nunca comite o arquivo preenchido).

# Conexão com o Postgres. Na Vercel isso é injetado automaticamente
# quando você conecta o banco Neon ao projeto — só precisa aqui pra rodar local.
DATABASE_URL=postgres://usuario:senha@host.neon.tech/neondb?sslmode=require

# Modo legado: senha única para todos os acessos.
# Se você quiser mais de um usuário, use APP_USUARIOS em vez disso.
APP_SENHA=troque-esta-senha

# Lista de usuários extras no formato: melo=1198,usuario2=outraSenha
# Exemplo: APP_USUARIOS=admin=troque-esta-senha,joao=troque-outra-senha
# Quando APP_USUARIOS estiver preenchido, o login pede usuário + senha.
# APP_USUARIOS=
